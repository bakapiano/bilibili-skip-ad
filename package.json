{
  "name": "biliskip-extension",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test tests/*.test.js tests/extension/*.test.js",
    "check": "node scripts/check-extension.js",
    "server": "node server/index.js",
    "deploy:server": "powershell -NoProfile -File server/deploy.ps1",
    "build:site": "node scripts/build-site.js",
    "verify": "npm run lint && npm run format:check && npm run check && npm test",
    "icons": "powershell -NoProfile -File scripts/generate-icons.ps1",
    "pack": "powershell -NoProfile -File scripts/package-extension.ps1",
    "pack:store": "powershell -NoProfile -File scripts/package-extension.ps1 -Store"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "prettier": "3.9.9"
  }
}
