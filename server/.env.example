# Copy to server/.env, then run:
# node --env-file=server/.env server/index.js
BILISKIP_HOST=127.0.0.1
BILISKIP_PORT=8787

# Blank uses data/shared-cache.sqlite, resolved relative to this project.
BILISKIP_DB_PATH=

# Optional separate token for a private group (16-200 non-whitespace characters).
BILISKIP_SHARED_TOKEN=

# Set to 127.0.0.1,::1 only when your local reverse proxy overwrites X-Real-IP.
# Direct clients use the socket IP when this value is blank.
BILISKIP_TRUSTED_PROXIES=
